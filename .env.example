# Catatan Negeri - Environment Variables Example
# Duplicate this file to .env and adjust values for your environment.

# Database connection (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/catatannegeri?schema=public"

# Authentication secret (Must be at least 32 characters for JOSE HS256)
JWT_SECRET="catatan-negeri-secure-production-jwt-token-secret-change-me"

# Public site configuration
NEXT_PUBLIC_SITE_URL="https://catatannegeri.com"
NEXT_PUBLIC_SITE_NAME="Catatan Negeri"
NEXT_PUBLIC_SITE_TAGLINE="Portal Berita & Informasi Digital Indonesia"

# Analytics (Optional)
NEXT_PUBLIC_GA_ID=""

# AI Editorial Assistant (Optional, e.g. OpenAI / Gemini)
AI_API_KEY=""
AI_API_PROVIDER="openai" # or gemini

